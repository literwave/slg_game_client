CCEffect %{
  techniques:
  - passes:
    - vert: city-vs:vert
      frag: city-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        cityUvX: { value: [1, 0, 0.5, 0] }
        cityUvY: { value: [0, -1, 0.5, 0] }
        cityRender: { value: [1, 1, 0, 0] }
        cityTone: { value: [1, 1, 0, 0] }
        cityTexture: { value: white }
}%
CCProgram city-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram city-fs %{
  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 300])
  precision highp float;
  in vec2 uv0;
  in vec4 color;
  uniform CityGround { vec4 cityUvX; vec4 cityUvY; vec4 cityTone; vec4 cityRender; };
  uniform sampler2D cityTexture;

  // 明度、饱和度、高光压缩按城图配置；压住浅色石地与金边，保留屋瓦暗部细节。
  vec3 cityPalette (vec3 rgb) {
    float luminance = dot(rgb, vec3(.2126, .7152, .0722));
    vec3 muted = mix(vec3(luminance), rgb, cityTone.y);
    float highlight = smoothstep(.45, .90, luminance);
    return muted * cityTone.x * (1.0 - cityTone.z * highlight);
  }

  float stoneNoise (vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
  }

  // 城道与地图使用相同的两条格轴。占地底座独立铺满九格，建筑仍保留完整线性投影。
  vec3 cityPaving (vec2 p) {
    vec2 axes = vec2(p.x + p.y, p.x - p.y);
    float edge = .498 - max(abs(axes.x), abs(axes.y));
    vec2 stone = (axes + .5) * vec2(28.0, 42.0);
    stone.x += mod(floor(stone.y), 2.0) * .5;
    vec2 cell = floor(stone), local = fract(stone);
    vec2 seam = min(local, 1.0 - local);
    // 砖缝按屏幕像素平滑，拉远时收掉细纹；不再叠逐像素砂粒噪声。
    // WebGL 1 必须显式启用导数扩展；无扩展的设备保留平滑底色，避免材质编译失败。
    float pixelWidth = 1.4;
    #if __VERSION__ < 300
      #ifdef GL_OES_standard_derivatives
        pixelWidth = max(fwidth(stone.x), fwidth(stone.y));
      #endif
    #else
      pixelWidth = max(fwidth(stone.x), fwidth(stone.y));
    #endif
    float detail = 1.0 - smoothstep(.35, 1.4, pixelWidth);
    float joint = 1.0 - smoothstep(.025 - pixelWidth * .5, .09 + pixelWidth * .5, min(seam.x, seam.y));
    float variation = (stoneNoise(cell) - .5) * .025 * detail;
    vec3 paving = vec3(.57, .525, .43) + variation;
    paving -= joint * .045 * detail;
    // 薄石沿压住地表接缝；不画粗边框，也不把未占领的邻格纳入底座。
    float rim = 1.0 - smoothstep(.006, .010, edge);
    vec3 curb = vec3(.61, .565, .465);
    paving = mix(paving, curb, rim);
    return paving * mix(.78, 1.0, smoothstep(.001, .004, edge));
  }

  vec4 frag () {
    vec3 p = vec3(vec2(uv0.x - .5, .5 - uv0.y) * cityRender.xy + cityRender.zw, 1.0);
    // 地基仍受左右边界与前方两条格线约束；新图屋顶可自然高出后方格线。
    if (cityUvX.w > .5) {
      if (abs(p.x) > .5 || p.y < abs(p.x) - .5) discard;
    } else if (abs(p.x) + abs(p.y) > .5) discard;
    vec2 sourceUV = vec2(dot(cityUvX.xyz, p), dot(cityUvY.xyz, p));
    vec4 city = vec4(0.0);
    if (sourceUV.x >= 0.0 && sourceUV.y >= 0.0 && sourceUV.x <= 1.0 && sourceUV.y <= 1.0) {
      city = texture(cityTexture, sourceUV);
    }
    // 原版十级城自带草地和城墙；透明处透出地图，避免额外的整块灰色石底。
    if (cityTone.w > .5) return vec4(cityPalette(city.rgb), city.a) * color;
    if (city.a >= .999) return vec4(cityPalette(city.rgb), city.a) * color;
    // 透明留白显示贴地城道；不用放大城图或裁断塔楼来填格。
    float groundAlpha = 1.0 - smoothstep(.497, .498, abs(p.x) + abs(p.y));
    float alpha = city.a + groundAlpha * (1.0 - city.a);
    vec3 rgb = (city.rgb * city.a + cityPaving(p.xy) * groundAlpha * (1.0 - city.a)) / max(alpha, .0001);
    return vec4(cityPalette(rgb), alpha) * color;
  }
}%
